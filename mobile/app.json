{
  "expo": {
    "name": "Take A Sip",
    "slug": "take-a-sip-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/welcome-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f1eb"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.takeasip.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Take A Sip uses notifications to send order updates and operational alerts.",
        "NSLocationWhenInUseUsageDescription": "Take A Sip uses your location during checkout to help select your delivery address and estimate delivery fees.",
        "NSPhotoLibraryUsageDescription": "Take A Sip allows admin users to choose menu images from the photo library.",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps"
        ]
      }
    },
    "android": {
      "package": "com.takeasip.mobile",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#f5f1eb"
      }
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-secure-store"
    ]
  }
}
