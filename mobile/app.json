{
  "expo": {
    "name": "خذلك شفة",
    "slug": "take-a-sip-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/welcome-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f1eb"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/ios-app-icon.png",
      "bundleIdentifier": "com.takeasip.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "يستخدم تطبيق خذلك شفة الإشعارات لإرسال تحديثات الطلب والتنبيهات التشغيلية.",
        "NSLocationWhenInUseUsageDescription": "يستخدم تطبيق خذلك شفة موقعك أثناء الدفع للمساعدة في اختيار عنوان التوصيل وتقدير رسوم التوصيل.",
        "NSPhotoLibraryUsageDescription": "يسمح تطبيق خذلك شفة لمستخدمي الإدارة باختيار صور القائمة من مكتبة الصور.",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps"
        ]
      }
    },
    "android": {
      "package": "com.takeasip.mobile",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#f5f1eb"
      }
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "يسمح تطبيق خذلك شفة لمستخدمي الإدارة باختيار صور القائمة من مكتبة الصور.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-secure-store"
    ]
  }
}
