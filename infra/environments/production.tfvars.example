project_id                     = "take-a-sip-production"
region                         = "us-central1"
environment                    = "production"
artifact_registry_repository_id = "take-a-sip-backend"
cloud_run_service_name         = "take-a-sip-backend-prod"
migration_job_name             = "take-a-sip-backend-migrate-prod"
initial_backend_image          = "us-central1-docker.pkg.dev/take-a-sip-production/take-a-sip-backend/backend:bootstrap"
health_path                    = "/health"
min_instance_count             = 0
max_instance_count             = 3

backend_runtime_env = {
  ENVIRONMENT    = "production"
  LOG_LEVEL      = "INFO"
  STORE_TIMEZONE = "Asia/Amman"
  STORE_LATITUDE  = "32.551347"
  STORE_LONGITUDE = "36.017005"
}

secret_ids = [
  "database-url",
  "migration-database-url",
  "mersal-api-key",
  "s3-access-key-id",
  "s3-secret-access-key",
  "jwt-secret-key",
  "twilio-account-sid",
  "twilio-auth-token",
  "twilio-from-number",
  "fcm-service-account-json",
  "apns-key-id",
  "apns-team-id",
  "apns-bundle-id",
  "apns-private-key"
]
