{
  "name": "take-a-sip-frontdesk",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios",
    "usb:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/usb-setup.ps1",
    "usb:recover": "powershell -ExecutionPolicy Bypass -File ./scripts/frontdesk-usb-recover.ps1 -Relaunch",
    "usb:recover:clear": "powershell -ExecutionPolicy Bypass -File ./scripts/frontdesk-usb-recover.ps1 -Relaunch -ClearData"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@react-navigation/stack": "^7.8.4",
    "axios": "^1.8.4",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.33",
    "expo-keep-awake": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "i18next": "^24.2.3",
    "react": "19.1.0",
    "react-i18next": "^15.4.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.1.10",
    "typescript": "^6.0.3"
  }
}
